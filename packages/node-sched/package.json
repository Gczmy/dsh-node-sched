{
  "name": "@zzc/dsh-node-sched",
  "description": "dsh host plugin for the sched node-level scheduler: SSH proxy to the remote sched CLI, read-only agent tools, dashboard RPC/WS plumbing; embedded SSH engine (pool/PTY/exec) adapted from Apache-2.0 dsh-web ssh plugin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/device-auth.js",
    "lib/host-trust.js",
    "lib/known-hosts.js",
    "lib/ssh-engine.js",
    "lib/transport.js",
    "lib/request-guard.js",
    "lib/upload-path.js",
    "lib/screen-result.js",
    "lib/output-limit.js",
    "lib/redact.js",
    "lib/retry-policy.js",
    "lib/entry-override.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.21.3",
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gpu-scheduler",
    "hpc",
    "ssh-proxy",
    "agent-tools"
  ]
}
