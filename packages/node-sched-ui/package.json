{
  "name": "@zzc/dsh-node-sched-ui",
  "description": "dsh client plugin: full-screen sched dashboard — batch grid with segmented progress, GPU panel, live event stream, dry-run-gated submit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-client.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dashboard",
    "gpu-monitor",
    "react"
  ],
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  }
}
