{
  "name": "dsh-node-sched-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "dsh plugin suite exposing the sched node-level GPU/CPU scheduler as a web dashboard and agent tool surface",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
